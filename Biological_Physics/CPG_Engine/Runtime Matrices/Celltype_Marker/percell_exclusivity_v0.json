{
 "_meta": {
  "what": "per-entry marker-panel exclusivity, measured from iamatlas_celltype_markers_v0_2.json",
  "why": "the panel selection criterion is one-vs-rest against the MEAN of the other cell types, which scores a globally extreme CpG highly for every cell type in which it is extreme. 33.8% of the 6,738 marker CpGs therefore belong to more than one entry's panel (one belongs to 11), and the median entry's panel is only 37% exclusive to it. A per-cell reading taken on a panel that is largely shared is not a reading of that cell type; it is a reading of a shared block.",
  "rule": "the report prints the number for every entry, and WITHHOLDS the individual per-cell claim (direction against its own healthy range) where exclusivity < 0.25 - the number is shown with the exclusivity beside it so a reader can see why",
  "does_not_touch": "the runtime marker file is unchanged: the sealed foundation-cohort anchors reproduce on it, so changing the selection criterion requires a re-seal (registered as a Roadmap item, not done here)",
  "measured": "2026-09-22",
  "n_entries": 115,
  "n_distinct_markers": 6738,
  "pct_markers_in_more_than_one_panel": 33.8,
  "max_panels_one_marker_serves": 11,
  "threshold": 0.25
 },
