+# ---------------------------------------------------------------- CELLS: every panel cell scored in whole blood (to-do step 21, 2026-10-21)
+# The instrument's job: each blood cell the Deconvolver finds gets its own reading; a healthy cell reads no loss, and a loss of that cell's
+# pattern is read as that loss. Nothing fitted. At cell c's identity sites the person's values depart from what their own mix predicts,
+# e = sum_g f_g mu_g (shares f from Stage D21, healthy means mu from IAM-Atlas v2.1). Signed toward 0.5 (a held mark drifting to the
+# random state) and divided by the cell's share and its pattern depth, the departure is the share of that cell's pattern lost:
+#     L_c = mean[(x - e) * sign(0.5 - mu_c)] / (f_c * mean|0.5 - mu_c|)      (healthy about 0; a 1 % loss of c's pattern adds exactly 0.01)
+# Its own noise: the sites, SE_sites = SD[(x - e) * sign(0.5 - mu_c)] / sqrt(n) / (f_c * mean|0.5 - mu_c|), and the share itself: a share
+# read too low looks exactly like a lost pattern at the cell's identity sites (L moves by about -df/f), so SE_share = sigma_f / f_c, sigma_f
+# from Stage D21's 95 % interval / 3.92. The detection limit is 2 x sqrt(SE_sites^2 + SE_share^2), in percent of the cell's pattern, at this
+# person's share. For a cell at a few percent of the blood the share's uncertainty sets the limit (found 2026-10-21 on a synthetic blood). Same-run healthy references, when given, tare it (L_c minus their median)
+# and give the reference-based limit (2 x their SD). Explored 2026-10-21: the entropy ratio Met-A uses is nearly blind for a minority cell in
+# a mixture (a 1 % B-cell loss at a 5 % share moved it by -0.00003), because the other cells dominate the value at its sites.
+# Identity sites: every site where c sits at least IDENTITY_SEP combined SD above or below EVERY other panel cell in the atlas, the
+# Deconvolver's own marker sites excluded (they set the shares, so reading on them would be circular). PRELIMINARY until commissioned.
+IDENTITY_SEP = 2.0      # the atlas's separation, in combined SD, to the nearest other panel cell (fixed rule, not tuned)
+MIN_SITES_SHARE = 0.9   # the same 90 % of identity sites Met-A requires
+CELLS_PRELIMINARY = "This score is preliminary until per-cell scoring in whole blood is officially commissioned on whole blood (EPIC v1)."
+_ID = {}
+
+def identity_sites(panel=None):
+    """({cell: sites}, mu) from IAM-Atlas v2.1, the Deconvolver's markers excluded. Cached."""
+    panel = list(panel or D21.BLOOD6)
+    if tuple(panel) in _ID: return _ID[tuple(panel)]
+    if tuple(panel) not in _REF:
+        R = D21.reference(panel); _REF[tuple(panel)] = (R, D21.markers(R))
+    R, M = _REF[tuple(panel)]; Ms = set(M)
+    mu, sd = R["mu"], R["sd"]; ok = mu.notna().all(1) & sd.notna().all(1); mu, sd = mu[ok], sd[ok]; out = {}
+    for c in panel:
+        o = [x for x in panel if x != c]; d = mu[o].sub(mu[c], axis=0); sp = np.sqrt(sd[o].pow(2).add(sd[c].pow(2), axis=0))
+        hi = (-d / sp).min(1); lo = (d / sp).min(1); keep = ((hi >= IDENTITY_SEP) | (lo >= IDENTITY_SEP)) & ~mu.index.isin(list(Ms))
+        out[c] = list(mu.index[keep])
+    _ID[tuple(panel)] = (out, mu); return _ID[tuple(panel)]
+
+def stage_cells(beta, d21, refs=None):
+    """One reading per panel cell: the share of its pattern lost. d21: Stage D21's record. refs: optional {cell: [L_c of same-run healthy arrays]}."""
+    rec = {"stage": "CELLS", "reading": "share of each panel cell's pattern lost, in whole blood", "reference": "IAM-Atlas v2.1 healthy means x this person's shares (Stage D21)",
+           "status": "preliminary", "label": CELLS_PRELIMINARY, "identity_sep": IDENTITY_SEP, "cells": []}
+    if not d21 or not d21.get("cells"):
+        rec["withheld"] = "no cell shares (Stage D21 withheld them), so there is no expectation to read against"
+        rec["explained"] = _ex("per-cell scores (Stage CELLS)", "withheld", "no shares from Stage D21", "the six shares from Stage D21",
+                               "stage_v4.stage_cells (fixed rule)", "each cell's expectation is built from this person's own shares",
+                               "see the cell-share record for why the shares were withheld"); return rec
+    panel = [x["cell"] for x in d21["cells"]]; f = {x["cell"]: float(x["share"]) for x in d21["cells"]}
+    sf = {x["cell"]: (float(x["interval_95"][1]) - float(x["interval_95"][0])) / 3.92 for x in d21["cells"] if x.get("interval_95")}
+    S, mu = identity_sites(panel); b = pd.Series(beta, dtype="float64"); b.index = b.index.astype(str)
+    for c in panel:
+        sc = pd.Index(S[c]); x = b.reindex(sc); e = sum(f[g] * mu[g].reindex(sc) for g in panel); ok = x.notna() & e.notna()
+        r = {"cell": c, "share": round(f[c], 4), "identity_sites": len(sc), "sites_measured": int(ok.sum()), "status": "preliminary"}
+        need = int(np.ceil(MIN_SITES_SHARE * len(sc)))
+        if f[c] <= 0:
+            r["reason"] = "share 0: the Deconvolver found none of this cell, so it has nothing to score"
+        elif ok.sum() < need:
+            r["reason"] = f"only {int(ok.sum())} of {len(sc)} identity sites measured ({need} required): score withheld"
+        else:
+            m = mu[c].reindex(sc)[ok]; w = np.sign(0.5 - m); depth = float((0.5 - m).abs().mean())
+            dw = (x[ok] - e[ok]) * w; L = float(dw.mean() / (f[c] * depth)); se = float(dw.std(ddof=1) / np.sqrt(len(dw)) / (f[c] * depth))
+            ses = sf.get(c, 0.0) / f[c]; tot = float(np.hypot(se, ses))
+            r.update(pattern_lost=round(L, 4), se_sites=round(se, 4), se_share=round(ses, 4), se=round(tot, 4), detection_limit_pct=round(200 * tot, 1),
+                     pattern_depth=round(depth, 4), state="no loss found" if abs(L) < 2 * tot else ("loss of pattern" if L > 0 else "more pattern than predicted"))
+            R_ = [v for v in ((refs or {}).get(c) or []) if v is not None and np.isfinite(v)]
+            if len(R_) >= 3:
+                med = float(np.median(R_)); r.update(pattern_lost_tared=round(L - med, 4), refs=len(R_), detection_limit_refs_pct=round(200 * float(np.std(R_, ddof=1)), 2))
+            else:
+                r["tare"] = f"untared: {len(R_)} same-run healthy references for this cell (at least 3 needed)"
+        rec["cells"].append(r)
+    return rec
+
