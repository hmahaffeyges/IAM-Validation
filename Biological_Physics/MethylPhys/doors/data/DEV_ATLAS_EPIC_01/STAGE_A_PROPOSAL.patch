@@ -0,0 +1,33 @@
+#!/usr/bin/env python3
+"""Stage A' PROPOSAL (DEV-ATLAS-EPIC-01, development, not commissioned): EPIC whole-blood composition from atlas v2.
+Solver: deconv_v2.DeconvV2 with the frozen SOLVER settings, on the atlas v2 cells that (1) circulate in blood, (2) were measured on arrays
+(roster 'platforms' contains 'array'), and (3) survive the mixture-identifiability rule (a cell whose template at the solver markers is
+reproduced by a non-negative sum-1 combination of the other cells with r >= twin_r of twin_family_thresholds_v1.json is removed; on atlas v2
+this removes 'b cells', 'cd4 t cells', 'cd8 t cells' - the unsorted parent entries). 12 cells. The 6,000 neutrophil identity sites are
+never composition markers. Second opinion: constrained ILC (NILC) on the same 12 templates, all sites with template range >= 0.2.
+Both are recorded; fractions are reported per 8 EPIC groups for Stage M. Settings chosen on GSE110554; see DEV_ATLAS_EPIC_01.md."""
+import json, os
+import numpy as np, pandas as pd
+import comp_methods as CM      # DEV_ATLAS_EPIC_01/code/comp_methods.py (would move into chain/)
+ATLAS_E_CELLS = ["basophils", "effector memory cd8 t cells", "eosinophils", "memory b cells", "memory cd4 t cells", "monocytes",
+                 "naive b cells", "naive cd4 t cells", "naive cd8 t cells", "neutrophils", "nk cells", "regulatory t cells"]
+_S = {}
+def build(atlas_parquet, neutrophil_sites):
+    if "D" not in _S:
+        A = CM.load_atlas(atlas_parquet); NS = pd.Index(neutrophil_sites)
+        D = CM.build_deconv(A, ATLAS_E_CELLS, NS)
+        Ab = CM.subset_atlas(A, ATLAS_E_CELLS); Ab = Ab.loc[Ab.index.difference(NS)]
+        mu = Ab[[f"{c}_mean" for c in ATLAS_E_CELLS]]; v = Ab[[f"{c}_sd" for c in ATLAS_E_CELLS]].values ** 2 + Ab[[f"{c}_donor_sd" for c in ATLAS_E_CELLS]].values ** 2
+        ok = mu.notna().all(1).values & np.isfinite(v).all(1); rng = (mu.max(1) - mu.min(1)).values; sel = ok & (rng >= 0.2)
+        N = CM.NILC(mu.index[sel], ATLAS_E_CELLS, mu.values[sel], v[sel], cov="atlas")
+        _S.update(D=D, N=N)
+    return _S["D"], _S["N"]
+def stage_a(beta, atlas_parquet, neutrophil_sites):
+    D, N = build(atlas_parquet, neutrophil_sites)
+    a = D.deconvolve(beta, n_boot=0); n = N.deconvolve(beta)
+    ga = CM.to_groups(a["fractions"]); gn = CM.to_groups(n["fractions"])
+    f8 = {g: float(ga.get(g, 0.0)) for g in CM.BLOOD8}
+    return {"stage": "A", "method": "atlas v2 solver, 12 array-measured circulating cells (DEV-ATLAS-EPIC-01 proposal)", "fractions": f8,
+            "cell_fractions": a["fractions"], "residual_mae": a["residual_mae"], "n_markers_used": a["n_markers_used"],
+            "nilc_second_opinion": {g: float(gn.get(g, 0.0)) for g in CM.BLOOD8}, "nilc_sum": n["sum"], "nilc_noise_sd": n["noise_sd"],
+            "max_abs_disagreement": float(max(abs(f8[g] - gn.get(g, 0.0)) for g in CM.BLOOD8))}
