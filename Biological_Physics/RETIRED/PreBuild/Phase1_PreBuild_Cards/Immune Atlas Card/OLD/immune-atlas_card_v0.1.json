  "pathway_routing_algorithm": {
    "description": "Ordered decision tree for routing a Stage-1-positive Stage-2-null case into one of the four pathways",
    "decision_tree": [
      {
        "step": 1,
        "check": "stage_1_signature_matches_known_disease_card_at_cross_platform_validated_tier",
        "if_true_action": "report_matched_card_signature_with_confidence_score",
        "if_false_go_to": 2
      },
      {
        "step": 2,
        "check": "clinical_symptoms_neurological_or_cognitive",
        "if_true_action": "route_to_pathway_1_terminal",
        "if_false_go_to": 3
      },
      {
        "step": 3,
        "check": "stage_1_magnitude_strong_AND_stage_3_EpiDISH_out_of_healthy_range",
        "if_true_action": "route_to_pathway_2_heme",
        "if_false_go_to": 4
      },
      {
        "step": 4,
        "check": "per_cpg_monocyte_FOXP3_ZBTB12_signature_match_AND_CVD_risk_factors_present",
        "if_true_action": "route_to_pathway_3_cardio",
        "if_false_go_to": 5
      },
      {
        "step": 5,
        "check": "default_when_no_specific_pattern_matched",
        "action": "route_to_pathway_4_trajectory_watch"
      }
    ]
  },

