# ==============================================================================
# IAM-Validation .gitignore
# ==============================================================================

# OS files
.DS_Store
Thumbs.db

# Cobaya packages (large external data, not part of IAM)
cobaya_packages/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# ==============================================================================
# Root-level files that belong in subdirectories
# These were accidentally committed to root and should live in their proper homes:
#   - PDFs → docs/
#   - Python scripts → tests/ or mgcamb_validation/
#   - YAML configs → mgcamb_validation/yaml_configs/
#   - Figures → figures/
# ==============================================================================

# Root-level PDFs (canonical copies live in docs/)
/Dual_Sector_Validation_Paper.pdf
/Holographic_Derivation_of_IAM.pdf
/IAM_CAMB_Technical_Note.pdf
/IAM_Manuscript.pdf
/IAM_Test_Validation_Compendium.pdf
/Supplementary_Methods_Reproducibiity_Guide.pdf
/Variational_Derivation_of_IAM.pdf

